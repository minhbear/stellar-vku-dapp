{
  "name": "stellar-vku-dapp",
  "private": true,
  "version": "0.1.0",
  "description": "Two teaching dapps on Stellar testnet for the VKU course: a shared travel pot and a freelance escrow",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:sharebill": "npm run dev -w @vku/sharebill",
    "dev:escrow": "npm run dev -w @vku/escrow",
    "build": "npm run build -w @vku/sharebill && npm run build -w @vku/escrow",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "contracts:test": "cd contracts && cargo test",
    "contracts:build": "cd contracts && cargo build --release --target wasm32v1-none",
    "contracts:deploy": "bash scripts/deploy-testnet.sh",
    "contracts:bindings": "bash scripts/bindings.sh"
  },
  "engines": {
    "node": ">=20.9"
  }
}
